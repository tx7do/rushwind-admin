# 脚本一律 LF。
*.sh text eol=lf
# proto 契约与 manifest 必须字节精确（checksum 门依赖），禁止任何 EOL 转换。
*.proto -text
backend/api/MANIFEST.sha256 -text
# 前端零改动快照与 manifest 同理：字节精确，禁止 EOL 转换（含快照内 husky 脚本，
# 规则置后以覆盖上面的 *.sh 规则）。
frontend/admin/react/** -text
frontend/admin/react.MANIFEST.sha256 -text
frontend/admin/react.UPSTREAM.sha256 -text
frontend/admin/vue-element/** -text
frontend/admin/vue-element.MANIFEST.sha256 -text
frontend/admin/vue-element.UPSTREAM.sha256 -text
frontend/admin/vue-vben/** -text
frontend/admin/vue-vben.MANIFEST.sha256 -text
frontend/admin/vue-vben.UPSTREAM.sha256 -text
